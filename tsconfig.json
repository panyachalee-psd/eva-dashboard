{
  "compilerOptions": {
    "target": "esnext",                   
    "module": "esnext",                   
    "lib": ["dom", "esnext"],   
    "types": ["jest", "node"],          
    "jsx": "react-jsx",                   
    "moduleResolution": "node",           
    "esModuleInterop": true,              
    "allowJs": true,                     
    "skipLibCheck": true,                
    "strict": true,                       
    "resolveJsonModule": true,            
    "noImplicitAny": true,                
    "baseUrl": ".",                       
    "paths": {
      "@/*": ["src/*"]                    
    }
  },
  "include": ["src"],                     
  "exclude": ["node_modules", "dist"]
}
